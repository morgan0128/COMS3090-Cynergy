<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- required for internet usage -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Synergy"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".activities.EventReviewActivity"
            android:exported="false" />
        <activity
            android:name=".activities.eventInviteActivity"
            android:exported="false" />
        <activity
            android:name=".activities.FriendChatActivity"
            android:exported="false" />
        <activity
            android:name=".activities.FriendsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.EventAttendanceActivity"
            android:exported="false" />
        <activity
            android:name=".activities.EventChatActivity"
            android:exported="false" />
        <activity android:name=".activities.AdminDashboardActivity" />
        <activity android:name=".activities.AdminUserDetailActivity" />
        <activity
            android:name=".items.Notifications"
            android:exported="false" />
        <activity
            android:name=".activities.EventsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.EditActivity"
            android:exported="false" />
        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Synergy" />
        <activity
            android:name=".activities.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".activities.DeleteActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".activities.AdminTicketActivity"
            android:exported="false" />
        <activity
            android:name=".activities.TicketRequestActivity"
            android:exported="false" />

        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApp.Splash">

            <!-- Splash theme loaded first -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".WebSocketService"
            android:exported="false" />
    </application>

</manifest>