<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Card background -->
    <solid android:color="#171A1F"/>

    <!-- Rounded corners -->
    <corners android:radius="16dp"/>

    <!-- Soft stroke to match the chip + dark UI -->
    <stroke
        android:width="1dp"
        android:color="#2B2F3A"/>

    <!-- Small shadow/glow illusion -->
    <padding
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp"/>
</shape>
