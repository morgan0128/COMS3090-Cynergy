<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/avatarChooserTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose an avatar"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:id="@+id/avatarRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/avatarLion"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/lion"
            android:contentDescription="Lion avatar"
            android:layout_margin="8dp" />

        <ImageView
            android:id="@+id/profile1"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/profile_1"
            android:layout_margin="8dp" />

        <ImageView
            android:id="@+id/profile2"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/profile_2"
            android:layout_margin="8dp" />

        <ImageView
            android:id="@+id/profile3"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/profile_3"
            android:layout_margin="8dp" />

        <ImageView
            android:id="@+id/profile4"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/profile_4"
            android:layout_margin="8dp" />

        <ImageView
            android:id="@+id/profile5"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/profile_5"
            android:layout_margin="8dp" />
    </LinearLayout>

</LinearLayout>
