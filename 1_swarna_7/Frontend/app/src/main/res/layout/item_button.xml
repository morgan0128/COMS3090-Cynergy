<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/eventCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/capsule_button"
    android:padding="20dp"
    android:layout_marginVertical="10dp"
    android:elevation="4dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Event Title -->
    <TextView
        android:id="@+id/textEventTitle"
        android:layout_width="286dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Sample Event Title"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Event Details Row -->

    <TextView
        android:id="@+id/textEventDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="5 PM | 8th Oct | Central Park | Organized by John"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

    <Button
        android:id="@+id/showAttendeesButton"
        android:layout_width="96dp"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:gravity="start"
        android:text="Attendees"
        android:textColor="#FFC107"
        android:textSize="15dp"
        android:visibility="gone"

        />

    <Button
        android:id="@+id/deleteEventButton"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:background="@android:color/transparent"
        android:text="Delete"
        android:padding="0dp"
        android:textColor="#FFC107"
        android:textSize="15dp"
        android:gravity="start"
        android:visibility="gone"
         />

</LinearLayout>