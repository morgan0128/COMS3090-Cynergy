<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/event_review_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activities.EventReviewActivity">


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/backbuttonToHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-10dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:background="@android:color/transparent"
        android:drawableStart="@drawable/ic_back_arrow"
        android:drawableTint="@color/black"
        android:paddingLeft="30dp"
        android:textColor="@color/white" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/eventReviewViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <!-- TabLayout now appears at the bottom -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/eventReviewTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabIndicatorColor="#FF0000"
        app:tabSelectedTextColor="@color/black"
        app:tabTextColor="@color/black" />


</LinearLayout>