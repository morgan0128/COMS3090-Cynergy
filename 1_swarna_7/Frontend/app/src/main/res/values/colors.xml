<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="red">#ff6b6b</color>
    <color name="blue">#4dabf7</color>
    <!-- Cardinal color-->
    <color name="splash_background">#990000</color>
    <!-- Normal App theme after the splash screen, inheriting attributes from parent -->
    <color name="gold">#EFBF04</color>
    <color name="bg_1">#0B0F14</color>
    <color name="card_1">#121826</color>
    <color name="card_2">#0E1420</color>
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#AEB7C2</color>
    <color name="accent">#8B5CF6</color>
    <color name="accent_high">#A78BFA</color> <!-- lighter accent -->
    <color name="success">#22C55E</color>
    <color name="danger">#EF4444</color>
    <color name="chip_bg">#1F2937</color>     <!-- dark chip bg -->
    <color name="divider">#233047</color>
    <color name="admin_blue">#233047</color>
    <color name="admin_red">#233047</color>
    <color name="adminDeepBlue">#264B7A</color>      <!-- back arrow -->
    <color name="adminSoftGreen">#7BAE8C</color>     <!-- dashboard button -->


    <style name="Theme.MyApp" parent="Theme.AppCompat.Light.NoActionBar">
    </style>

    <!-- Splash theme inheriting from Splash Screen-->
    <style name="Theme.MyApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/owl</item>
        <!-- Shows up after the splash screen is over -->
        <item name="postSplashScreenTheme">@style/Theme.MyApp</item>

    </style>


</resources>